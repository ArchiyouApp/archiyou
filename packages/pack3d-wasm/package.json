{
  "name": "@archiyou/pack3d-wasm",
  "version": "0.1.0",
  "description": "Stable 3D load planning (boxes into pallets, crates and trailers) compiled to WebAssembly: every item stands, with weight, stacking, unloading-order and balance rules, and the same plan on every machine.",
  "license": "Apache-2.0",
  "author": "Mark van der Net (Archiyou)",
  "type": "module",
  "main": "./ts/index.ts",
  "types": "./ts/index.ts",
  "exports": {
    ".": "./ts/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:wasm": "./build.sh",
    "typecheck": "tsc --noEmit",
    "rust:check": "cargo check --target wasm32-unknown-unknown",
    "rust:test": "cargo test",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs && pnpm build"
  },
  "keywords": [
    "bin-packing",
    "container-loading",
    "pallet",
    "3d",
    "wasm",
    "archiyou"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchiyouApp/archiyou-web.git",
    "directory": "packages/pack3d-wasm"
  },
  "homepage": "https://archiyou.com",
  "bugs": {
    "url": "https://github.com/ArchiyouApp/archiyou-web/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
