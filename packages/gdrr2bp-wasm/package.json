{
  "name": "@archiyou/gdrr2bp-wasm",
  "version": "0.1.0",
  "description": "2D guillotine bin packing (goal-driven ruin & recreate) compiled to WebAssembly, with a typed TypeScript wrapper.",
  "license": "MIT",
  "author": "Mark van der Net (Archiyou)",
  "type": "module",
  "main": "./ts/index.ts",
  "types": "./ts/index.ts",
  "exports": {
    ".": "./ts/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:wasm": "wasm-pack build --target bundler",
    "rust:check": "cargo check --target wasm32-unknown-unknown",
    "rust:test": "cargo test",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs && pnpm build"
  },
  "keywords": [
    "bin-packing",
    "nesting",
    "guillotine",
    "2d",
    "wasm",
    "archiyou"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchiyouApp/archiyou-web.git",
    "directory": "packages/gdrr2bp-wasm"
  },
  "homepage": "https://archiyou.com",
  "bugs": {
    "url": "https://github.com/ArchiyouApp/archiyou-web/issues"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
