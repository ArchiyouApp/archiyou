# The one .env for Archiyou: copy to `.env` in the repository root.
# Read by the server (pnpm dev), the editor build (only SERVER_API_BASE_URL) and docker compose.

# --- Frontend ---
# Public origin of the editor and configurators: email links, published URLs, CORS.
FRONTEND_URL=https://next.archiyou.com
# Where the editor calls the API, inlined at build time. Dev: uncomment. Production: leave unset (/api).
# SERVER_API_BASE_URL=http://localhost:4100

# --- Server ---
SERVER_PORT=4100
# Required in production. Generate with: openssl rand -base64 48
SERVER_JWT_SECRET=change-me-to-a-long-random-string
# Extra browser origins allowed to call the API, comma-separated (FRONTEND_URL always is).
SERVER_CORS_ORIGINS=
# Maximum request body in bytes.
SERVER_BODY_LIMIT_BYTES=4194304

# --- Database (PostgreSQL) ---
# Empty = PGlite in ./data/pglite (no install). Or postgres://user:pass@host:5432/db, or memory://
SERVER_DATABASE_URL=
# Used by docker compose to start Postgres. POSTGRES_PASW is required for the production stack.
POSTGRES_USER=archiyou
POSTGRES_PASW=
POSTGRES_DB=archiyou

# --- Server-side script execution (Redis/BullMQ) ---
# WARNING: scripts run unsandboxed in the worker. Both gates are off by default.
# Authors whose scripts may run for authenticated callers, comma-separated.
SERVER_EXECUTION_AUTHORS=
# 1 = admin-validated published versions may run for anyone (configurators).
SERVER_EXECUTION_VALIDATED=
SERVER_EXECUTION_RATE_LIMIT=30
SERVER_EXECUTION_RATE_WINDOW=1 minute
SERVER_EXECUTION_TIMEOUT_MS=30000
# Where the worker reaches the API (http://api:4100 under docker compose).
SERVER_INTERNAL_API_URL=

# --- Redis ---
SERVER_REDIS_HOST=localhost
SERVER_REDIS_PORT=6379
SERVER_REDIS_PASSWORD=
# Used by docker compose to start Redis with a password. Empty = Redis runs open.
REDIS_PASW=

# --- Email (Mailgun) ---
# Empty key = links are logged to the server console instead of emailed.
SERVER_MAILGUN_KEY=
SERVER_MAILGUN_DOMAIN=mg.archiyou.com
SERVER_MAILGUN_API_BASE=https://api.eu.mailgun.net
SERVER_EMAIL_FROM=Archiyou <info@archiyou.com>

# --- Development test account ---
# Seeded in dev. In production only with SERVER_SEED_TEST_USER=true and a real password.
SERVER_TEST_USER_USERNAME=test
SERVER_TEST_USER_EMAIL=test@archiyou.com
SERVER_TEST_USER_PASSWORD=test1234
SERVER_TEST_USER_NAME=Test User
# SERVER_SEED_TEST_USER=false

# --- Asset proxy (editor $import()) ---
# Hostnames allowed, comma-separated. Empty = any public host (SSRF-guarded).
SERVER_PROXY_ALLOWLIST=
SERVER_PROXY_MAX_BYTES=5242880
SERVER_PROXY_TIMEOUT_MS=10000
SERVER_PROXY_MAX_REDIRECTS=4
SERVER_PROXY_RATE_LIMIT=60
SERVER_PROXY_RATE_WINDOW_MS=60000

# --- Script modules (see modules/README.md) ---
# Leave empty: modules are found in modules/. Set other roots, or `off` to load none.
SERVER_MODULES_DIR=
# Reload modules without a restart. Default on outside production; 0 = off.
SERVER_MODULES_DEV=
SERVER_MODULES_CALL_TIMEOUT_MS=60000
SERVER_MODULES_POOL_SIZE=2
SERVER_MODULES_RATE_LIMIT=60
SERVER_MODULES_RATE_WINDOW_MS=60000
# A module sees only its own <ID>_* variables, like these for cloudcalc (all optional):
# CLOUDCALC_SHEETS='{"pricing":"https://docs.google.com/spreadsheets/d/…"}'
# CLOUDCALC_GOOGLE_CREDENTIALS='{"type":"service_account", …}'
# CLOUDCALC_DRIVE_FOLDER_ID=
# CLOUDCALC_COPY_SHARE=anyone-reader
# CLOUDCALC_CACHE_TTL_MS=60000
# CLOUDCALC_ALLOW_ANY_URL=
# CLOUDCALC_ALLOW_LOCAL_FILES=

# --- Configurator translation (Google Gemini) ---
# Empty key = off: configurators stay in the language they were written in.
SERVER_GEMINI_API_KEY=
SERVER_GEMINI_MODEL=gemini-2.5-flash
SERVER_GEMINI_TIMEOUT_MS=60000
SERVER_GEMINI_MAX_KEYS=400
SERVER_GEMINI_MAX_JOBS_PER_HOUR=20

# --- Script thumbnails ---
# Must be on a persistent volume in production.
SERVER_THUMBNAIL_PATH=./data/thumbnails
SERVER_THUMBNAIL_URL_PREFIX=/thumbnails
SERVER_THUMBNAIL_MAX_BYTES=65536
# Log of every thumbnail and why one was dropped (JSON Lines). Empty = off.
SERVER_THUMBNAIL_LOG=./data/logs/thumbnails.log
SERVER_THUMBNAIL_LOG_MAX_BYTES=5242880

# --- Rate limits (per IP) ---
SERVER_AUTH_RATE_LIMIT=10
SERVER_AUTH_RATE_WINDOW=5 minutes
SERVER_FEEDBACK_RATE_LIMIT=10
SERVER_FEEDBACK_RATE_WINDOW=10 minutes
