# Global options.
#
# Automatic HTTPS is on by default in Caddy 2 for any site addressed by hostname,
# so there is nothing to switch on here. (This block previously said
# `auto_https on`, which is not valid syntax — the only accepted values are off /
# disable_redirects / disable_certs / ignore_loaded_certs — so `caddy validate`
# failed and the proxy would not have started at all.)
#
# Uncomment for a staging deploy to avoid Let's Encrypt rate limits while testing:
# {
#   acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
# }

# ─────────────────────────────────────────────────────────────────────────────
# Editor + API on ONE origin.
#
# Serving the app and the API from the same host means the browser never makes a
# cross-origin request, so CORS is out of the picture entirely. The server's
# routes live at the root (/auth, /scripts, /proxy, /health), so `handle_path`
# strips the /api prefix before proxying — /api/auth/login reaches the server as
# /auth/login. Build the editor with SERVER_API_BASE_URL=/api to match.
#
# Replace app.archiyou.com with your own domain.
# ─────────────────────────────────────────────────────────────────────────────
next.archiyou.com {
	encode zstd gzip

	# --- API (prefix stripped) ---
	handle_path /api/* {
		reverse_proxy api:4100
	}

	# --- Configurator pages: the SPA shell with social-card tags ---
	# Link crawlers (Slack, LinkedIn, WhatsApp, X) run no JavaScript, so a configurator's
	# title, description and preview image must be in the HTML itself. The API serves the
	# same shell with those tags written in (apps/server/src/services/SocialCard.ts).
	handle /configurators/* {
		reverse_proxy api:4100
	}

	# --- Links: /go/<key> redirects to a copy that may still be being made (routes/links.ts) ---
	handle /go/* {
		reverse_proxy api:4100
	}

	# --- Editor SPA ---
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}

	# The API is down, or still building the editor on boot: configurator pages fall
	# back to the plain shell, exactly as they were served before the route above.
	handle_errors {
		@configurator {
			path /configurators/*
			expression {err.status_code} >= 502
		}
		handle @configurator {
			root * /srv/app
			rewrite * /index.html
			# A page, not an error: without this the shell would go out as a 502.
			file_server {
				status 200
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The app frames its own published configurators, and embedding a
		# configurator elsewhere is a product feature, so DENY is wrong here
		# (unlike on the API vhost). CSP frame-ancestors below is the real control.
		X-Frame-Options "SAMEORIGIN"

		# Content-Security-Policy. Every allowance below is load-bearing — check
		# against the code before tightening:
		#   'unsafe-eval'  the script Runner compiles user scripts with
		#                  new AsyncFunction (packages/core/src/runner/Runner.ts)
		#   blob:          Vite's module workers are URL/blob based, and client
		#                  modules are imported from blob: URLs (loadClientModule.ts)
		#   data:          WASM ships inlined as base64 and is decoded at runtime
		#   fonts.googleapis/gstatic  webfonts in index.html
		#   cdn.jsdelivr.net          lucide icon sprites (src/icons.ts)
		#   www.gstatic.com           Draco decoder (packages/ui model-viewer.ts)
		#   docs.google.com, *.googleusercontent.com, oauth2.googleapis.com,
		#   www.googleapis.com        Google Sheets a script reads, fetched by the
		#                  editor's main thread before the run — public ones from the
		#                  export URL (which redirects to googleusercontent), private
		#                  ones through the Drive API with the user's own service
		#                  account (apps/editor/src/services/secret-manager.ts)
		#   sheets.googleapis.com     writing a script's inputs into a copy of a sheet the
		#                  user made from the editor (cloudcalc's copy(), same file)
		# Vendoring those three CDNs would let script-src/font-src drop to 'self'.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' blob: https://cdn.jsdelivr.net https://www.gstatic.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob: data: https://cdn.jsdelivr.net https://www.gstatic.com https://docs.google.com https://*.googleusercontent.com https://oauth2.googleapis.com https://www.googleapis.com https://sheets.googleapis.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
	}
}

