# Copy to .env and fill in. Only a Google Gemini key is needed.
GEMINI_API_KEY=...

# Optional model overrides
# GEMINI_DATA_MODEL=gemini-2.5-pro
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Resume mode for generate:data — only (re)generate materials missing/incomplete in
# materials.json, skipping ones already done. Useful after a transient API error (503).
# ONLY_UPDATE=true
