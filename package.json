{
  "name": "archiyou",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.32.1"
  },
  "scripts": {
    "build": "turbo build",
    "build:editor": "pnpm --filter @archiyou/editor build:prod",
    "build:editor:dev": "pnpm --filter @archiyou/editor build:dev",
    "dev": "turbo dev --filter=@archiyou/editor --filter=@archiyou/server",
    "dev:editor": "turbo dev --filter=@archiyou/editor",
    "dev:server": "turbo dev --filter=@archiyou/server",
    "dev:worker": "pnpm --filter @archiyou/server worker:dev",
    "test": "turbo test",
    "commit:ai": "node scripts/ai-commit.mjs",
    "docker:prod": "docker compose up -d",
    "docker:prod:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --wait",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "build:wasm": "turbo build:wasm",
    "build:meshup": "pnpm --filter @archiyou/meshup build",
    "watch:meshup": "pnpm --filter @archiyou/meshup build -- --watch",
    "test:core": "pnpm --filter @archiyou/core test",
    "test:meshup": "pnpm --filter @archiyou/meshup test",
    "lockfile:public": "node scripts/lockfile-public.mjs",
    "dbdownload": "node scripts/db-download.mjs",
    "localize:extract": "lit-localize extract",
    "localize:build": "lit-localize build",
    "dev:modules": "concurrently -n build,app -c cyan,green \"turbo watch build --filter=./modules/**\" \"turbo dev --filter=@archiyou/editor --filter=@archiyou/server\""
  },
  "dependencies": {
    "@archiyou/meshup": "workspace:*",
    "@awesome.me/webawesome": "^3.4.0",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.35.0",
    "@dile/editor": "^2.6.30",
    "@lezer/highlight": "^1.2.3",
    "@lit-labs/signals": "^0.2.0",
    "@lit/localize": "^0.12.2",
    "@panzoom/panzoom": "^4.6.2",
    "@vaadin/router": "^1.7.5",
    "codemirror": "^6.0.1",
    "comlink": "^4.4.2",
    "json5": "^2.2.3",
    "lit": "^3.2.0",
    "lucide-static": "^1.16.0",
    "oidc-client-ts": "^3.1.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.7.2",
    "@types/node": "^25.5.0",
    "@types/three": "^0.171.0",
    "concurrently": "^9.2.1",
    "turbo": "^2.10.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
