{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["nl"],
  "tsConfig": "./tsconfig.json",
  "output": {
    "mode": "runtime",
    "outputDir": "./src/i18n/translations",
    "localeCodesModule": "./src/i18n/locale-codes.ts"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "./src/i18n/translations"
  }
}
