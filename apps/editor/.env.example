# Editor app env. Copy to `.env` for local dev.
#
# IMPORTANT: this is read at BUILD time, not at runtime. Vite inlines the value
# into the bundle (see src/services/api.ts), so changing it means rebuilding —
# you cannot repoint an existing build at a different API by editing a file on
# the server.
#
# Base URL of the backend API (apps/server). Leave empty to call the same origin
# the editor is served from.
SERVER_API_BASE_URL=http://localhost:4100

# --- Production ---
# In the recommended deployment (the repo-root Caddyfile) one host serves both the
# editor and the API, with Caddy stripping an /api prefix. Build with:
#
#   SERVER_API_BASE_URL=/api pnpm --filter @archiyou/editor build
#
# That keeps every request same-origin, so CORS never applies. Use an absolute
# URL only if you deliberately split the editor and API across hostnames — then
# add a vhost for it in the Caddyfile and put the editor's origin in
# SERVER_CORS_ORIGINS on the server.
#
# Prefer that inline variable over a `.env.prod` file. Two silent traps otherwise:
#   - `.env*` files are gitignored, so they are absent in a server-side checkout;
#     the value falls back to '' and the editor calls its own origin
#     (https://host/auth/login instead of https://host/api/auth/login).
#   - `.env.prod` is read only by `pnpm build:prod` (mode "prod"). Plain
#     `vite build` uses mode "production" and looks for `.env.production`.
# An inline `SERVER_API_BASE_URL=...` is picked up in every mode, file or no file.

# --- Version label ---
# The version shown at the bottom of the editor's main menu comes from
# apps/editor/package.json ("version"). Override it per build, inline only
# (it is read from process.env in vite.config.ts, not from this file):
#
#   VITE_APP_VERSION=0.1.0+$(git rev-parse --short HEAD) pnpm --filter @archiyou/editor build
