{
  "name": "@archiyou/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Archiyou backend — editor auth + per-user script (version) DB, published-script library, and server-side execution. Combines the former @archiyou/server + @archiyou/publish into one package.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx --tsconfig ./tsconfig.runtime.json src/execution/worker.ts",
    "worker:dev": "tsx watch --tsconfig ./tsconfig.runtime.json src/execution/worker.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:own": "node ../../scripts/typecheck-own.mjs apps/server",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:library": "tsx src/admin/library.admin.ts",
    "admin:import-cadscripts": "tsx src/admin/import-cadscripts.ts",
    "admin:backup": "tsx src/admin/backup.ts",
    "admin:migrate-sqlite": "tsx src/admin/migrate-sqlite-to-pg.ts",
    "admin:modules": "tsx src/admin/modules.admin.ts",
    "admin:users": "tsx src/admin/users.admin.ts",
    "docker:dev": "docker compose -f docker-compose.yml up --force-recreate",
    "test": "vitest run ./tests/unit/",
    "test:unit": "vitest run ./tests/unit/",
    "test:parity": "vitest run ./tests/parity/"
  },
  "dependencies": {
    "@archiyou/core": "workspace:*",
    "@archiyou/module-sdk": "workspace:*",
    "@archiyou/types": "workspace:*",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/lib-storage": "^3.1104.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@google/genai": "^1.44.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.70.4",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.29.1",
    "form-data": "^4.0.5",
    "ioredis": "^5.10.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "semver": "^7.7.4",
    "typebox": "^1.1.21"
  },
  "devDependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ioredis": "^5.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.7.0",
    "ajv": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "^11.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
