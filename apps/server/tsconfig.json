{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "declaration": false,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@archiyou/core": [
        "../../packages/core/src/index.ts"
      ],
      "@archiyou/core/src/*": [
        "../../packages/core/src/*"
      ],
      "@archiyou/types": [
        "../../packages/types/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
